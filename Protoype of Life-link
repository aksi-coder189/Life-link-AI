        <div class="stat"><div class="val">96%</div><div class="lbl">Hospital match accuracy</div></div>
      </div>
    </section>

    <!-- SCREEN 2: EMERGENCY (voice + photo + severity gauge) -->
    <section class="screen" id="screen-emergency">
      <div class="eyebrow">Step 02 · Emergency assessment</div>
      <h1 class="screen-title">Tell us what's happening</h1>
      <p class="screen-sub">Bystander answers by voice. Scene photo analyzed by vision AI.</p>

      <div class="grid-2">
        <div class="panel">
          <div class="assess-col-head">Voice assistant — symptom questions</div>
          <div class="transcript" id="transcript"></div>
          <div class="voice-controls">
            <button class="btn primary" id="voiceNext">▶ Play next exchange</button>
            <button class="btn" id="voiceAll">Play all</button>
          </div>
          <div class="no-typing">◆ No typing required — full exchange captured by voice in 19 seconds</div>
        </div>

        <div class="panel">
          <div class="assess-col-head">Injury photo upload</div>
          <div class="upload-zone" id="uploadZone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v3a2 2 0 002 2h12a2 2 0 002-2v-3"/></svg>
            <div class="hint" id="uploadHint">Drop an accident photo here — or tap to simulate upload</div>
          </div>
          <div class="tag-list" id="scanResult" style="display:none;">
            <div class="tag-row"><span class="name">Possible fracture</span><span class="val">Right forearm</span></div>
            <div class="tag-row"><span class="name">Bleeding</span><span class="val">Heavy</span></div>
            <div class="tag-row"><span class="name">Burn detected</span><span class="val">None</span></div>
            <div class="tag-row"><span class="name">Body region</span><span class="val">Upper limb / torso</span></div>
          </div>
        </div>
      </div>

      <div class="severity-panel">
        <div class="severity-head">
          <div class="t">Emergency Severity Gauge</div>
          <div class="pct" id="sevPct">94%</div>
        </div>
        <div class="severity-bar-track"><div class="severity-bar-fill" id="sevFill" style="width:94%;"></div></div>
        <div class="severity-verdict">● Critical — immediate dispatch recommended</div>
      </div>
    </section>

    <!-- SCREEN 3: ASSESSMENT (3-column AI analysis) -->
    <section class="screen" id="screen-assessment">
      <div class="eyebrow">Step 03 · AI analysis</div>
      <h1 class="screen-title">Possible Fracture · Critical</h1>
      <p class="screen-sub">Voice, image and medical history merged in ~15 seconds.</p>

      <div class="assess-grid">
        <div class="panel">
          <div class="assess-col-head">Patient Summary</div>
          <div class="mini-row"><span class="k">Name</span><span class="v">Rahul, 34</span></div>
          <div class="mini-row"><span class="k">Blood group</span><span class="v">B+</span></div>
          <div class="mini-row"><span class="k">Allergies</span><span class="v" style="color:var(--warning);">Penicillin</span></div>
