    <div class="topbar-actions">
      <div class="emergency-badge" id="emergencyBadge">
        <span class="eb-icon">🚨</span>
        <span class="eb-text">
          <span class="eb-title">Emergency Active</span>
          <span class="eb-sub">Golden Hour · <span id="ghMini">43 min</span> remaining</span>
        </span>
      </div>
