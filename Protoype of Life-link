  <div class="case-banner" id="caseBanner" style="display:none;">
    <div class="cb-chip lead">🚗 Road Accident Detected</div>
    <div class="cb-chip">Female · 26</div>
    <div class="cb-chip">Possible Head Trauma</div>
    <div class="cb-spacer"></div>
    <div class="case-id" id="caseId" style="border-left:none;padding-left:0;">CASE #PIQ-40217</div>
    <div class="clock" id="clock">--:--:--</div>
  </div>

  <div class="main" id="main">

    <!-- SCREEN 1: HOME -->
    <section class="screen" id="screen-dashboard">
      <div class="eyebrow">Step 01 · Get help started</div>
      <h1 class="screen-title">Every Second Matters.</h1>
      <p class="screen-sub">One tap connects patient, ambulance, hospital and family — instantly.</p>

      <div class="pulse-trigger">
