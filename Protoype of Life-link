          <div class="sos-sub">TAP FOR HELP</div>
        </div>
        <div class="trigger-label">Report an emergency</div>
        <div class="trigger-sub">Tap to open a live case · connects to the nearest PulseIQ-linked ambulance</div>
      </div>

      <div class="type-grid">
        <div class="type-card"><div class="icon">🚗</div><div class="label">Accident</div></div>
        <div class="type-card"><div class="icon">🫀</div><div class="label">Heart Attack</div></div>
        <div class="type-card"><div class="icon">🧠</div><div class="label">Stroke</div></div>
        <div class="type-card"><div class="icon">🔥</div><div class="label">Burns</div></div>
        <div class="type-card"><div class="icon">🤰</div><div class="label">Pregnancy</div></div>
        <div class="type-card"><div class="icon">☠️</div><div class="label">Poisoning</div></div>
        <div class="type-card"><div class="icon">🐍</div><div class="label">Snake Bite</div></div>
        <div class="type-card"><div class="icon">➕</div><div class="label">Other</div></div>
      </div>

      <div class="stat-row">
        <div class="stat"><div class="val">142</div><div class="lbl">People helped today</div></div>
        <div class="stat"><div class="val">37</div><div class="lbl">Ambulances online</div></div>
