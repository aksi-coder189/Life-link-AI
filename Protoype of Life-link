        <path d="M12 2L4 5v6c0 5.2 3.6 9.4 8 11 4.4-1.6 8-5.8 8-11V5l-8-3z" stroke="#2F6FED" stroke-width="1.4"/>
        <path d="M7 12h2.5l1.3-3 2 6 1.3-3H17" stroke="#FF6F58" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div>
        <div class="brand-name">LifeLink AI</div>
        <div class="brand-tag">AI-Powered Emergency Intelligence</div>
