              <div class="checklist">
                <div class="check-item"><div class="box"></div>Cardiac cath lab pre-alerted</div>
                <div class="check-item"><div class="box"></div>Blood bank notified — B+ reserved</div>
                <div class="check-item"><div class="box"></div>Penicillin-free protocol flagged to pharmacy</div>
                <div class="check-item"><div class="box"></div>ICU bed B4 held, not released</div>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top:18px;" class="doctor-card-grid">
          <div class="dcard">
            <div class="name">Anita M. <span class="sev high">HIGH</span></div>
            <div class="row"><span>Blood Group</span><b>O-</b></div>
            <div class="row"><span>Allergies</span><b>None</b></div>
            <div class="row"><span>ETA</span><b>18 min</b></div>
            <div class="row"><span>Recommended</span><b>Ortho consult</b></div>
          </div>
          <div class="dcard">
            <div class="name">Suresh K. <span class="sev critical">CRITICAL</span></div>
            <div class="row"><span>Blood Group</span><b>AB+</b></div>
            <div class="row"><span>Allergies</span><b>Sulfa drugs</b></div>
            <div class="row"><span>ETA</span><b>6 min</b></div>
            <div class="row"><span>Recommended</span><b>Neuro ICU</b></div>
          </div>
        </div>
      </div>
    </section>

    <!-- SCREEN 7: FAMILY DASHBOARD -->
    <section class="screen" id="screen-family">
      <div class="eyebrow">Step 07 · Family tracking</div>
      <h1 class="screen-title">Keeping the family close, calmly</h1>
      <p class="screen-sub">A calm, live status feed for the family.</p>

      <div class="panel" style="max-width:560px;">
        <div class="timeline">
          <div class="t-item"><div class="node"></div><div class="line"></div><div class="body"><b>Ambulance dispatched</b><div class="sub">14:02 · 2.1 km from scene</div></div></div>
          <div class="t-item"><div class="node"></div><div class="line"></div><div class="body"><b>Hospital selected — Apollo</b><div class="sub">Trauma-ready · ICU bed pre-held</div></div></div>
          <div class="t-item"><div class="node"></div><div class="line"></div><div class="body"><b>En route — live location shared</b><div class="sub">ETA 11 min</div></div></div>
          <div class="t-item pending"><div class="node"></div><div class="body"><b>Arriving &amp; treatment started</b><div class="sub">Doctor assigned automatically</div></div></div>
        </div>
        <div class="reassure">Rahul is being taken to <b>Apollo Hospital</b>, arriving in about <b>11 minutes</b>. The trauma team is ready and waiting. You'll get an update the moment he's admitted.</div>
      </div>
    </section>

    <!-- SCREEN 8: ANALYTICS (government / command dashboard) -->
    <section class="screen" id="screen-analytics">
      <div class="console">
        <div class="eyebrow">Step 08 · City command center</div>
        <h1 class="screen-title">Government Dashboard</h1>
        <p class="screen-sub">City-wide emergency operations at a glance.</p>

        <div class="kpi-row">
          <div class="kpi"><div class="val">4m 12s</div><div class="lbl">Avg. response time</div></div>
          <div class="kpi"><div class="val">312</div><div class="lbl">Active cases today</div></div>
          <div class="kpi"><div class="val" style="color:var(--c-high);">81%</div><div class="lbl">City ICU occupancy</div></div>
          <div class="kpi"><div class="val" style="color:var(--c-ready);">96%</div><div class="lbl">Hospital match accuracy</div></div>
        </div>

        <div class="grid-2">
          <div class="panel">
            <div class="assess-col-head" style="color:var(--c-muted);border-color:var(--c-border);">Emergency Heatmap — city zones</div>
            <div class="heatmap" id="heatmap"></div>
          </div>
          <div class="panel">
            <div class="assess-col-head" style="color:var(--c-muted);border-color:var(--c-border);">Emergency Trends — last 7 days</div>
            <div class="bar-chart-wrap">
              <div class="bar-chart">
                <div class="bar" style="height:55%;"><span class="bv">210</span></div>
                <div class="bar" style="height:70%;"><span class="bv">268</span></div>
                <div class="bar" style="height:48%;"><span class="bv">184</span></div>
                <div class="bar" style="height:82%;"><span class="bv">312</span></div>
                <div class="bar" style="height:64%;"><span class="bv">245</span></div>
                <div class="bar" style="height:90%;"><span class="bv">341</span></div>
                <div class="bar" style="height:75%;"><span class="bv">289</span></div>
              </div>
              <div class="bxlbl"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
            </div>
          </div>
        </div>

        <div class="panel" style="margin-top:18px;">
          <div class="assess-col-head" style="color:var(--c-muted);border-color:var(--c-border);">ICU Occupancy by hospital</div>
          <div class="icu-row">
            <div class="icu-cell"><div class="city">Apollo</div><div class="icu-ring-num" style="color:var(--c-ready);">62%</div></div>
            <div class="icu-cell"><div class="city">Fortis</div><div class="icu-ring-num" style="color:var(--c-critical);">97%</div></div>
            <div class="icu-cell"><div class="city">Max</div><div class="icu-ring-num" style="color:var(--c-high);">84%</div></div>
            <div class="icu-cell"><div class="city">Medanta</div><div class="icu-ring-num" style="color:var(--c-ready);">55%</div></div>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
// ---- Clock ----
function tick(){ document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-GB'); }
setInterval(tick,1000); tick();

// ---- Golden hour countdown (cosmetic, resets on demo/reset) ----
let ghSeconds = 42*60;
const GH_TOTAL = 60*60;
function renderGh(){
  const m = Math.floor(ghSeconds/60), s = ghSeconds%60;
  const str = m+':' + String(s).padStart(2,'0');
  document.getElementById('ghTime').textContent = str;
  const lg = document.getElementById('liveGh'); if(lg) lg.textContent = str;
  const mini = document.getElementById('ghMini'); if(mini) mini.textContent = m+' min';
  const pct = Math.max(0, Math.min(100, (ghSeconds/GH_TOTAL)*100));
  document.getElementById('ghFill').style.width = pct+'%';
  const fill = document.getElementById('ghFill');
  if(pct < 20) fill.style.background = 'var(--critical)';
  else if(pct < 50) fill.style.background = 'linear-gradient(90deg,var(--warning),var(--critical))';
  else fill.style.background = 'linear-gradient(90deg,var(--success),var(--warning))';
}
setInterval(()=>{ if(ghSeconds>0){ ghSeconds--; renderGh(); } }, 1000);
renderGh();

// ---- Heatmap generation ----
(function(){
  const hm = document.getElementById('heatmap');
  const colors = ['#0f5f58','#177a6e','#22d3c5','#ff9f1c','#ff4136'];
  for(let i=0;i<48;i++){
    const c = colors[Math.floor(Math.random()*colors.length)];
    const cell = document.createElement('div');
    cell.className='heat-cell';
    cell.style.background=c;
    cell.style.opacity = (0.5+Math.random()*0.5).toFixed(2);
    hm.appendChild(cell);
  }
})();

// ---- Nav / screen switching ----
const screens = ['dashboard','emergency','assessment','hospital','ambulance','doctor','family','analytics'];
// 5-step case stepper: ① Report ② Assess ③ Recommend ④ Dispatch ⑤ Treat
const timelineMin = {dashboard:-1, emergency:0, assessment:1, hospital:2, ambulance:3, doctor:4, family:4, analytics:-1};
let current = 0;

function updateTimeline(name){
  const strip = document.getElementById('statusStrip');
  const banner = document.getElementById('caseBanner');
  const min = timelineMin[name];
  if(min === -1){
    strip.classList.remove('show');
    banner.style.display = 'none';
    return;
  }
  strip.classList.add('show');
  banner.style.display = 'flex';
  document.querySelectorAll('.step').forEach(el=>{
    const m = parseInt(el.dataset.min,10);
    el.classList.toggle('done', m < min);
    el.classList.toggle('active', m === min);
  });
}

function showScreen(name){
  screens.forEach(s=>{
    document.getElementById('screen-'+s).classList.toggle('active', s===name);
  });
  document.querySelectorAll('.navitem').forEach(el=>{
    el.classList.toggle('active', el.dataset.screen===name);
  });
  current = screens.indexOf(name);
  updateTimeline(name);
}
document.querySelectorAll('.navitem').forEach(el=>{
  el.addEventListener('click', ()=>{ stopDemo(); showScreen(el.dataset.screen); });
});
showScreen('dashboard');

// ---- Screen 1 trigger ----
document.getElementById('triggerBtn').addEventListener('click', ()=> showScreen('emergency'));
document.querySelectorAll('.type-card').forEach(c=>{
  c.addEventListener('click', ()=> showScreen('emergency'));
});

// ---- Screen 2 voice transcript ----
const qa = [
  {ai:"Is the patient breathing?", user:"Yes"},
  {ai:"Is there visible bleeding?", user:"Yes — from the arm"},
  {ai:"Can the patient move or respond?", user:"No"},
  {ai:"Any known allergies?", user:"Unknown"}
];
let qaIndex = 0;
function renderQA(i){
  const t = document.getElementById('transcript');
  const pair = qa[i];
  const b1 = document.createElement('div'); b1.className='bubble ai'; b1.textContent = pair.ai;
  const b2 = document.createElement('div'); b2.className='bubble user'; b2.textContent = pair.user;
  t.appendChild(b1);
  setTimeout(()=>t.appendChild(b2), 350);
}
function resetVoice(){ document.getElementById('transcript').innerHTML=''; qaIndex = 0; }
document.getElementById('voiceNext').addEventListener('click', ()=>{
  if(qaIndex >= qa.length){ resetVoice(); return; }
  renderQA(qaIndex); qaIndex++;
});
document.getElementById('voiceAll').addEventListener('click', ()=>{
  resetVoice();
  qa.forEach((p,i)=> setTimeout(()=>{ renderQA(i); qaIndex=i+1; }, i*800));
});

// ---- Screen 2 upload simulate ----
document.getElementById('uploadZone').addEventListener('click', ()=>{
  document.getElementById('uploadHint').textContent = 'accident_scene_04.jpg — analysing…';
  setTimeout(()=>{
    document.getElementById('uploadHint').textContent = 'accident_scene_04.jpg — analysis complete';
    document.getElementById('scanResult').style.display='flex';
  }, 700);
});

// ---- Ambulance dot animation ----
let ambT = 0;
const ambPath = document.querySelector('#screen-ambulance path:nth-of-type(1)');
function animateAmb(){
  if(!ambPath) return;
  const len = ambPath.getTotalLength();
  ambT = (ambT + 1.2) % len;
  const pt = ambPath.getPointAtLength(ambT);
  const dot = document.getElementById('ambDot');
  if(dot){ dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y); }
  requestAnimationFrame(animateAmb);
}
requestAnimationFrame(animateAmb);

// ---- Play full demo ----
let demoTimer = null;
function stopDemo(){
  if(demoTimer){ clearInterval(demoTimer); demoTimer = null; }
  document.getElementById('playDemo').textContent = '▶ Play full demo';
}
document.getElementById('playDemo').addEventListener('click', ()=>{
  if(demoTimer){ stopDemo(); return; }
  document.getElementById('playDemo').textContent = '⏸ Playing… (click to stop)';
  ghSeconds = 42*60; renderGh();
  showScreen('dashboard');
  let step = 0;
  demoTimer = setInterval(()=>{
    step++;
    if(step >= screens.length){ stopDemo(); return; }
    showScreen(screens[step]);
    if(screens[step]==='emergency'){
      resetVoice();
      qa.forEach((p,i)=> setTimeout(()=>{ renderQA(i); qaIndex=i+1; }, i*700));
      document.getElementById('scanResult').style.display='none';
      document.getElementById('uploadHint').textContent = 'Drop an accident photo here — or tap to simulate upload';
      setTimeout(()=>{
        document.getElementById('uploadHint').textContent = 'accident_scene_04.jpg — analysis complete';
        document.getElementById('scanResult').style.display='flex';
      }, 900);
    }
  }, 4200);
});
document.getElementById('resetDemo').addEventListener('click', ()=>{
  stopDemo();
  resetVoice();
  document.getElementById('scanResult').style.display='none';
  document.getElementById('uploadHint').textContent = 'Drop an accident photo here — or tap to simulate upload';
  ghSeconds = 42*60; renderGh();
  showScreen('dashboard');
});
</script>
</body>
</html>
