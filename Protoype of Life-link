      <div class="gh-time" id="ghTime">42:00</div>
    </div>
    <div class="stepper" id="stepper">
      <div class="step" data-min="0"><div class="step-dot">①</div><div class="step-lbl">Report</div></div>
      <div class="step" data-min="1"><div class="step-dot">②</div><div class="step-lbl">Assess</div></div>
      <div class="step" data-min="2"><div class="step-dot">③</div><div class="step-lbl">Recommend</div></div>
