                <div class="vital"><div class="l">ETA</div><div class="v" style="color:var(--c-brand);">11 min</div></div>
                <div class="vital"><div class="l">Severity</div><div class="v" style="color:var(--c-critical);">Critical</div></div>
                <div class="vital"><div class="l">Recommended Tx</div><div class="v">Cath lab</div></div>
