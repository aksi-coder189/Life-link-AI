          <div class="mini-row"><span class="k">Mechanism</span><span class="v">Road accident</span></div>
        </div>

        <div class="ai-engine-card">
          <div class="ai-engine-head">
            <div class="t">🤖 AI Decision Engine</div>
          </div>
          <div class="ai-conf-block" style="text-align:left;display:flex;align-items:baseline;gap:10px;margin-bottom:16px;">
            <div class="ai-conf">94%</div>
            <div class="ai-conf-lbl">Confidence · Risk Level <b style="color:var(--c-critical);">High</b></div>
          </div>
          <div class="ai-reasons">
            <div class="ai-reason"><span class="check">✓</span> Fracture pattern matched</div>
            <div class="ai-reason"><span class="check">✓</span> Vitals consistent</div>
            <div class="ai-reason"><span class="check">✓</span> Voice symptoms confirm</div>
            <div class="ai-reason"><span class="check">✓</span> Image analysis confirms</div>
          </div>
          <div class="ai-model-row">
            <span>Model: <b>Vision Model + Symptom Classifier</b></span>
            <span class="ai-dots"><span>.</span><span>.</span><span>.</span> live</span>
          </div>
        </div>

        <div class="panel">
          <div class="assess-col-head">Recommended Actions</div>
          <div class="action-callout">⚠ Immediate CT Recommended</div>
          <div class="action-item"><div class="dot"></div>Alert trauma team before arrival</div>
          <div class="action-item"><div class="dot"></div>Reserve OR &amp; CT slot at destination</div>
          <div class="action-item"><div class="dot"></div>Blood bank notified — B+ reserved</div>
          <div class="action-item"><div class="dot"></div>Flag penicillin-free protocol to pharmacy</div>
          <div class="action-item"><div class="dot"></div>Begin IV fluids en route</div>
        </div>
      </div>
    </section>

    <!-- SCREEN 4: HOSPITAL -->
