<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title> LifeLink AI — AI-Powered Emergency Intelligence Platform</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root{
  --bg:#FFF7F1;
  --bg-blob-1: radial-gradient(circle at 8% -10%, #FFDCCB 0%, rgba(255,220,203,0) 55%);
  --bg-blob-2: radial-gradient(circle at 100% 0%, #FFE9DD 0%, rgba(255,233,221,0) 45%);
  --panel:#FFFFFF;
  --panel2:#FFF1E7;
  --border:#F4DECC;
  --text:#2C2119;
  --muted:#8F7B70;
  --muted-dim:#C2AC9E;
  /* semantic status palette (emergency system layer) */
  --primary:#2F6FED;
  --primary-tint:#E7EEFD;
  --primary-deep:#1E52C2;
  --success:#1FA97A;
  --success-tint:#DFF3EB;
  --warning:#E8A33D;
  --warning-tint:#FBEEDA;
  --critical:#E14C3D;
  --critical-tint:#FCE3DF;
  --neutral:#8A8078;
  --brand:#FF6F58;          /* patient-facing warmth accent, used sparingly */
  --brand-ink:#FFFFFF;
  --brand-tint:#FFE1D5;
  --brand-deep:#E4543E;
  --high:#E8A33D;
  --high-tint:#FBEEDA;
  --medium:#F0BB43;
  --ready:#1FA97A;
  --ready-tint:#DFF3EB;
  --route:#2F6FED;
  --shadow: 0 10px 30px -12px rgba(47,111,237,0.14);
  --shadow-sm: 0 4px 14px -6px rgba(44,33,25,0.10);
  --font-display:'Fraunces', serif;
  --font-body:'Plus Jakarta Sans', sans-serif;
  --font-mono:'IBM Plex Mono', monospace;

  /* AEGIS console layer (doctor / analytics) */
  --c-bg:#0a0e13;
  --c-panel:#111820;
  --c-panel2:#161f29;
  --c-border:#22303c;
  --c-text:#e7edf2;
  --c-muted:#7d8fa0;
  --c-muted-dim:#4d5c6b;
  --c-brand:#22d3c5;
  --c-brand-dim:#0f5f58;
  --c-critical:#ff4136;
  --c-high:#ff9f1c;
  --c-ready:#2ecc71;
  --c-route:#3da9fc;
  --c-font-display:'Oswald', var(--font-display);
}
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap');
*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--font-body);}
body{
  height:100vh;
  overflow:hidden;
  background-image: var(--bg-blob-1), var(--bg-blob-2);
  background-repeat:no-repeat;
}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:var(--brand-tint);border-radius:4px;}
::-webkit-scrollbar-track{background:transparent;}

.app{display:flex;flex-direction:column;height:100vh;}

/* ---- TOP BAR ---- */
.topbar{
  flex-shrink:0;
  background:linear-gradient(180deg, #FFFFFF, #FFF7F1);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:12px 24px;gap:18px;flex-wrap:wrap;
}
.brand{display:flex;align-items:center;gap:10px;}
.brand svg{width:30px;height:30px;flex-shrink:0;}
.brand-name{font-family:var(--font-display);font-size:21px;font-weight:600;letter-spacing:0.2px;color:var(--text);}
.brand-tag{font-family:var(--font-mono);font-size:10px;color:var(--muted);letter-spacing:0.5px;margin-top:-2px;}

.nav{display:flex;flex:1;justify-content:center;gap:4px;flex-wrap:wrap;}
.navitem{
  display:flex;align-items:center;gap:7px;padding:9px 15px;border-radius:22px;
  font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;border:1px solid transparent;
  transition:background .15s, color .15s, border-color .15s;white-space:nowrap;
}
.navitem:hover{background:var(--panel2);color:var(--text);}
.navitem.active{background:var(--primary);color:#fff;border-color:var(--primary);box-shadow:var(--shadow-sm);}
.navitem .n{font-family:var(--font-mono);font-size:10px;opacity:.65;}

.topbar-actions{display:flex;align-items:center;gap:10px;flex-shrink:0;}

/* small elegant emergency indicator, top right */
.emergency-badge{
  display:flex;align-items:center;gap:9px;background:var(--critical-tint);border:1px solid rgba(225,76,61,0.3);
  border-radius:14px;padding:6px 13px 6px 11px;
}
.emergency-badge .eb-icon{font-size:15px;line-height:1;}
.emergency-badge .eb-text{display:flex;flex-direction:column;line-height:1.25;}
.emergency-badge .eb-title{font-size:11px;font-weight:700;color:var(--critical);letter-spacing:0.2px;}
.emergency-badge .eb-sub{font-family:var(--font-mono);font-size:10px;color:var(--critical);opacity:.75;}

.live-pill{
  display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:11px;color:var(--critical);
  border:1px solid rgba(225,76,61,0.3);background:var(--critical-tint);padding:6px 11px;border-radius:20px;letter-spacing:.5px;
}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--critical);}
.demo-btn{
  background:var(--primary);color:#fff;border:none;font-family:var(--font-body);font-weight:600;letter-spacing:.2px;
  font-size:12.5px;padding:10px 16px;border-radius:22px;cursor:pointer;box-shadow:var(--shadow-sm);
}
.demo-btn:hover{filter:brightness(1.06);}
.reset-btn{
  background:transparent;border:1px solid var(--border);color:var(--muted);font-family:var(--font-body);
  font-weight:500;font-size:12.5px;padding:9px 14px;border-radius:22px;cursor:pointer;
}
.reset-btn:hover{border-color:var(--primary);color:var(--primary-deep);}

/* ---- GOLDEN HOUR + 5-STEP STEPPER STRIP ---- */
.status-strip{flex-shrink:0;border-bottom:1px solid var(--border);background:var(--panel);padding:11px 24px;display:none;}
.status-strip.show{display:block;}
.gh-row{display:flex;align-items:center;gap:14px;margin-bottom:12px;}
.gh-label{font-family:var(--font-mono);font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);white-space:nowrap;}
.gh-track{flex:1;height:8px;border-radius:5px;background:var(--panel2);border:1px solid var(--border);overflow:hidden;}
.gh-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--success),var(--warning));transition:width 1s linear, background .6s;}
.gh-time{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--critical);white-space:nowrap;min-width:64px;text-align:right;}

.stepper{display:flex;align-items:flex-start;justify-content:space-between;}
.step{display:flex;flex-direction:column;align-items:center;flex:1;position:relative;}
.step:not(:last-child)::after{content:"";position:absolute;top:13px;left:58%;width:84%;height:2px;background:var(--border);z-index:0;}
.step.done:not(:last-child)::after{background:var(--success);}
.step-dot{
  width:26px;height:26px;border-radius:50%;background:var(--panel2);border:2px solid var(--border);
  display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:11px;font-weight:700;
  color:var(--muted-dim);z-index:1;
}
.step.done .step-dot{background:var(--success);border-color:var(--success);color:#fff;}
.step.active .step-dot{background:var(--primary);border-color:var(--primary);color:#fff;box-shadow:0 0 0 5px var(--primary-tint);}
.step-lbl{font-size:11px;color:var(--muted);margin-top:6px;font-weight:500;}
.step.active .step-lbl{color:var(--primary-deep);font-weight:700;}
.step.done .step-lbl{color:var(--success);}

/* ---- CASE BANNER (patient snapshot) ---- */
.case-banner{
  flex-shrink:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  padding:9px 24px;border-bottom:1px solid var(--border);background:var(--bg);
}
.cb-chip{
  display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:5px 11px;border-radius:14px;
  background:var(--panel2);border:1px solid var(--border);color:var(--text);white-space:nowrap;
}
.cb-chip.lead{background:var(--critical-tint);border-color:rgba(225,76,61,0.3);color:var(--critical);}
.cb-spacer{flex:1;}
.clock{font-family:var(--font-mono);font-size:11.5px;color:var(--muted);}
.case-id{font-family:var(--font-mono);font-size:11.5px;color:var(--muted-dim);border-left:1px solid var(--border);padding-left:16px;}

/* ---- MAIN ---- */
.main{flex:1;overflow-y:auto;padding:26px 40px 70px;position:relative;}
.screen{display:none;animation:fadeIn .35s ease;}
.screen.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

.eyebrow{font-family:var(--font-mono);font-size:11px;color:var(--primary-deep);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;}
h1.screen-title{font-family:var(--font-display);font-size:34px;font-weight:600;letter-spacing:0.1px;margin:0 0 6px;color:var(--text);}
.screen-sub{color:var(--muted);font-size:14px;margin-bottom:24px;max-width:680px;line-height:1.6;}

.panel{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:24px;box-shadow:var(--shadow-sm);}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;}

.btn{font-family:var(--font-body);font-weight:600;font-size:13px;padding:11px 20px;border-radius:24px;border:1px solid var(--border);background:var(--panel2);color:var(--text);cursor:pointer;}
.btn:hover{border-color:var(--primary);}
.btn.primary{background:var(--primary);color:#fff;border:none;box-shadow:var(--shadow-sm);}
.btn.primary:hover{filter:brightness(1.06);}
.btn.critical{background:var(--critical);color:#fff;border:none;}
.btn:disabled{opacity:0.35;cursor:not-allowed;}

/* ---------------- SCREEN 1: HOME ---------------- */
.pulse-trigger{
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  background:radial-gradient(circle at 50% 20%, var(--critical-tint), transparent 70%), var(--panel);
  border:1px solid var(--border);border-radius:20px;padding:48px 20px;text-align:center;margin-bottom:24px;box-shadow:var(--shadow);
}
.trigger-ring{
  width:124px;height:124px;border-radius:50%;background:var(--critical);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  box-shadow:0 0 0 0 rgba(225,76,61,0.5);animation:ring 1.8s infinite;cursor:pointer;margin-bottom:20px;
}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(225,76,61,0.45);}70%{box-shadow:0 0 0 26px rgba(225,76,61,0);}100%{box-shadow:0 0 0 0 rgba(225,76,61,0);}}
.trigger-ring .sos{font-family:var(--font-display);font-size:22px;font-weight:700;color:#fff;letter-spacing:1.5px;}
.trigger-ring .sos-sub{font-family:var(--font-mono);font-size:9px;color:rgba(255,255,255,0.85);letter-spacing:1px;margin-top:2px;}
.trigger-label{font-family:var(--font-display);font-size:21px;letter-spacing:0.3px;font-weight:600;}
.trigger-sub{color:var(--muted);font-size:13px;margin-top:6px;}

.type-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.type-card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px 12px;text-align:center;cursor:pointer;transition:border-color .15s, transform .15s, box-shadow .15s;}
.type-card:hover{border-color:var(--primary);transform:translateY(-2px);box-shadow:var(--shadow-sm);}
.type-card .icon{font-size:24px;margin-bottom:7px;}
.type-card .label{font-size:12.5px;color:var(--muted);font-weight:500;}

.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.stat{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px;}
.stat .val{font-family:var(--font-mono);font-size:24px;color:var(--primary-deep);font-weight:600;}
.stat .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;margin-top:5px;}

/* ---------------- SCREEN 2: EMERGENCY (voice + photo + severity) ---------------- */
.transcript{display:flex;flex-direction:column;gap:12px;min-height:120px;}
.bubble{padding:12px 15px;border-radius:14px;font-size:13.5px;line-height:1.5;max-width:92%;}
.bubble.ai{background:var(--panel2);border:1px solid var(--border);align-self:flex-start;color:var(--text);}
.bubble.ai::before{content:"PULSEIQ CARE ASSISTANT";display:block;font-family:var(--font-mono);font-size:9px;color:var(--primary-deep);letter-spacing:0.8px;margin-bottom:5px;}
.bubble.user{background:var(--brand-tint);border:1px solid rgba(255,111,88,0.35);align-self:flex-end;color:var(--text);}
.bubble.user::before{content:"BYSTANDER";display:block;font-family:var(--font-mono);font-size:9px;color:var(--muted);letter-spacing:0.8px;margin-bottom:5px;}
.voice-controls{margin-top:16px;display:flex;gap:10px;}
.no-typing{font-family:var(--font-mono);font-size:10.5px;color:var(--muted-dim);margin-top:14px;}

.upload-zone{border:1.5px dashed var(--border);border-radius:16px;padding:30px;text-align:center;background:var(--panel2);cursor:pointer;transition:border-color .15s;}
.upload-zone:hover{border-color:var(--primary);}
.upload-zone svg{width:30px;height:30px;color:var(--muted);margin-bottom:8px;}
.upload-zone .hint{color:var(--muted);font-size:12px;}
.tag-list{display:flex;flex-direction:column;gap:8px;margin-top:14px;}
.tag-row{display:flex;align-items:center;justify-content:space-between;background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:10px 13px;}
.tag-row .name{font-size:12.5px;}
.tag-row .val{font-family:var(--font-mono);font-size:12.5px;color:var(--warning);font-weight:600;}

.severity-panel{margin-top:20px;background:var(--c-bg);border-radius:14px;padding:20px 22px;color:var(--c-text);}
.severity-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.severity-head .t{font-family:var(--c-font-display);text-transform:uppercase;letter-spacing:1.5px;font-size:12px;color:var(--c-muted);}
.severity-head .pct{font-family:var(--font-mono);font-size:22px;font-weight:600;color:var(--c-critical);}
.severity-bar-track{height:14px;border-radius:7px;background:var(--c-panel2);overflow:hidden;border:1px solid var(--c-border);}
.severity-bar-fill{height:100%;border-radius:7px;background:linear-gradient(90deg,var(--c-high),var(--c-critical));}
.severity-verdict{font-family:var(--font-mono);font-size:11px;color:var(--c-critical);letter-spacing:1px;text-transform:uppercase;margin-top:10px;}

/* ---------------- SCREEN 3: ASSESSMENT (3-column redesign) ---------------- */
.assess-grid{display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:18px;align-items:start;}
.assess-col-head{font-family:var(--font-mono);font-size:10.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border);}
.mini-row{display:flex;justify-content:space-between;font-size:12.5px;padding:8px 0;border-bottom:1px dashed var(--border);}
.mini-row:last-child{border-bottom:none;}
.mini-row .k{color:var(--muted);}
.mini-row .v{font-weight:600;}
.action-item{display:flex;gap:10px;align-items:flex-start;font-size:13px;padding:9px 0;border-bottom:1px dashed var(--border);}
.action-item:last-child{border-bottom:none;}
.action-item .dot{width:7px;height:7px;border-radius:50%;background:var(--primary);margin-top:5px;flex-shrink:0;}
.action-callout{background:var(--critical-tint);border:1px solid rgba(225,76,61,0.3);border-radius:10px;padding:12px 15px;font-size:12.5px;color:var(--critical);font-weight:600;margin-bottom:14px;}

/* ---------------- SCREEN 4: HOSPITAL — flight-style comparison ---------------- */
.flight-row{display:flex;gap:18px;align-items:stretch;margin-bottom:22px;}
.flight-card{
  background:var(--panel);border:1px solid var(--border);border-radius:18px;padding:26px;position:relative;
  display:flex;flex-direction:column;
}
.flight-card.winner{
  flex:1.5;border-color:var(--primary);box-shadow:0 0 0 2px var(--primary) inset, var(--shadow);background:linear-gradient(180deg,var(--panel),var(--primary-tint) 260%);
}
.flight-card.minor{flex:1;padding:22px;justify-content:center;}
.fc-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;}
.fc-name{font-family:var(--font-display);font-size:21px;font-weight:600;}
.fc-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:0.8px;text-transform:uppercase;color:var(--primary-deep);margin-top:3px;}
.fc-score-block{text-align:right;}
.fc-score{font-family:var(--font-mono);font-size:42px;font-weight:700;line-height:1;color:var(--success);}
.fc-score.mid{color:var(--warning);font-size:30px;}
.fc-score.lo{color:var(--critical);font-size:30px;}
.fc-score-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.6px;}
.fc-eta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text);background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:9px 14px;margin-bottom:16px;width:fit-content;}
.fc-eta b{font-family:var(--font-mono);}
.fc-why-head{font-family:var(--font-mono);font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;}
.fc-why{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.fc-why-item{display:flex;align-items:center;gap:8px;font-size:12.5px;background:var(--panel2);border:1px solid var(--border);border-radius:8px;padding:8px 11px;}
.fc-why-item .ck{color:var(--success);font-weight:700;}
.fc-minor-name{font-family:var(--font-display);font-size:15px;font-weight:600;margin-bottom:10px;text-align:center;}
.fc-minor-reason{font-size:11.5px;color:var(--critical);text-align:center;margin-top:8px;font-weight:600;}

/* ---------------- Reusable AI Decision Engine card ---------------- */
.ai-engine-card{background:var(--c-bg);border-radius:16px;padding:24px 26px;color:var(--c-text);}
.ai-engine-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.ai-engine-head .t{font-family:var(--c-font-display);text-transform:uppercase;letter-spacing:1.5px;font-size:13px;color:var(--c-brand);display:flex;align-items:center;gap:9px;}
.ai-conf-block{text-align:right;}
.ai-conf{font-family:var(--font-mono);font-size:30px;font-weight:700;color:var(--c-brand);line-height:1;}
.ai-conf-lbl{font-size:9.5px;color:var(--c-muted);text-transform:uppercase;letter-spacing:0.6px;}
.ai-reasons{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-bottom:14px;}
.ai-reason{display:flex;align-items:center;gap:9px;font-size:12.5px;background:var(--c-panel2);border:1px solid var(--c-border);border-radius:8px;padding:9px 12px;}
.ai-reason .check{color:var(--c-brand);font-weight:700;}
.ai-model-row{display:flex;align-items:center;justify-content:space-between;font-family:var(--font-mono);font-size:10.5px;color:var(--c-muted-dim);border-top:1px solid var(--c-border);padding-top:12px;}
.ai-model-row b{color:var(--c-muted);font-weight:600;}
.ai-dots span{animation:aiDots 1.2s infinite;opacity:0;}
.ai-dots span:nth-child(2){animation-delay:.2s;}
.ai-dots span:nth-child(3){animation-delay:.4s;}
@keyframes aiDots{0%{opacity:0;}30%{opacity:1;}60%{opacity:0;}100%{opacity:0;}}

/* ---------------- SCREEN 5: AMBULANCE / LIVE TRACKING ---------------- */
.route-panel{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:26px;}
.route-svg-wrap{position:relative;background:var(--panel2);border-radius:14px;border:1px solid var(--border);padding:20px;}
.checkpoints{display:flex;justify-content:space-between;margin-top:22px;}
.cp{text-align:center;flex:1;}
.cp .dot{width:12px;height:12px;border-radius:50%;background:var(--muted-dim);margin:0 auto 8px;}
.cp.done .dot{background:var(--success);}
.cp.active .dot{background:var(--primary);box-shadow:0 0 0 5px var(--primary-tint);}
.cp .lbl{font-size:11px;color:var(--muted);}
.cp .time{font-family:var(--font-mono);font-size:10px;color:var(--muted-dim);}
.live-widget-row{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:22px;}
.live-widget{background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:15px;text-align:center;}
.live-widget .icon{font-size:18px;margin-bottom:6px;}
.live-widget .val{font-family:var(--font-mono);font-size:16px;font-weight:700;color:var(--primary-deep);}
.live-widget .lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:3px;}

/* ---------------- CONSOLE (AEGIS scoped: Doctor / Analytics) ---------------- */
.console{background:var(--c-bg);border-radius:18px;padding:26px 28px 30px;color:var(--c-text);font-family:var(--font-body);}
.console .eyebrow{color:var(--c-brand);}
.console h1.screen-title{color:var(--c-text);font-family:var(--c-font-display);}
.console .screen-sub{color:var(--c-muted);}
.console .panel{background:var(--c-panel);border:1px solid var(--c-border);box-shadow:none;}
.console .grid-2{gap:18px;}
.console .grid-3{gap:18px;}

.patient-card{display:grid;grid-template-columns:180px 1fr;gap:22px;}
.avatar-block{background:var(--c-panel2);border:1px solid var(--c-border);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;text-align:center;}
.avatar-circle{width:60px;height:60px;border-radius:50%;background:var(--c-brand-dim);display:flex;align-items:center;justify-content:center;font-family:var(--c-font-display);font-size:21px;font-weight:600;color:var(--c-brand);margin-bottom:10px;}
.level-badge{display:inline-flex;align-items:center;gap:8px;font-family:var(--c-font-display);font-size:14px;letter-spacing:1px;font-weight:600;padding:8px 16px;border-radius:30px;text-transform:uppercase;}
.level-badge.critical{background:rgba(255,65,54,0.12);color:var(--c-critical);border:1px solid rgba(255,65,54,0.4);}
.vitals-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px;}
.vital{background:var(--c-panel2);border:1px solid var(--c-border);border-radius:10px;padding:12px 14px;}
.vital .l{font-size:10px;color:var(--c-muted);text-transform:uppercase;letter-spacing:0.5px;}
.vital .v{font-family:var(--font-mono);font-size:15px;margin-top:3px;font-weight:600;color:var(--c-text);}
.checklist{margin-top:18px;display:flex;flex-direction:column;gap:9px;}
.check-item{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--c-text);}
.check-item .box{width:15px;height:15px;border:1px solid var(--c-brand);border-radius:4px;background:rgba(34,211,197,0.15);flex-shrink:0;}

.doctor-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.dcard{background:var(--c-panel);border:1px solid var(--c-border);border-radius:12px;padding:18px 20px;}
.dcard .name{font-family:var(--c-font-display);font-size:16px;letter-spacing:0.5px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
.dcard .sev{font-family:var(--font-mono);font-size:10px;padding:3px 9px;border-radius:12px;letter-spacing:0.5px;}
.dcard .sev.critical{background:rgba(255,65,54,0.15);color:var(--c-critical);}
.dcard .sev.high{background:rgba(255,159,28,0.15);color:var(--c-high);}
.dcard .row{display:flex;justify-content:space-between;font-size:12px;padding:5px 0;color:var(--c-muted);border-bottom:1px solid var(--c-border);}
.dcard .row:last-child{border-bottom:none;}
.dcard .row b{color:var(--c-text);font-weight:500;}

/* ---------------- SCREEN 8: ANALYTICS (government dashboard) ---------------- */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
.kpi{background:var(--c-panel);border:1px solid var(--c-border);border-radius:12px;padding:16px 18px;}
.kpi .val{font-family:var(--font-mono);font-size:23px;font-weight:700;color:var(--c-brand);}
.kpi .lbl{font-size:10.5px;color:var(--c-muted);text-transform:uppercase;letter-spacing:0.6px;margin-top:4px;}
.heatmap{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;}
.heat-cell{aspect-ratio:1;border-radius:3px;}
.bar-chart{display:flex;align-items:flex-end;gap:8px;height:140px;padding-top:10px;}
.bar-chart .bar{flex:1;background:linear-gradient(180deg,var(--c-brand),var(--c-brand-dim));border-radius:4px 4px 0 0;position:relative;}
.bar-chart .bar .bv{position:absolute;top:-18px;left:0;right:0;text-align:center;font-family:var(--font-mono);font-size:10px;color:var(--c-muted);}
.bar-chart .bxlbl{display:flex;gap:8px;margin-top:6px;}
.bar-chart-wrap .bxlbl span{flex:1;text-align:center;font-size:10px;color:var(--c-muted);font-family:var(--font-mono);}
.icu-row{display:flex;gap:14px;}
.icu-cell{flex:1;background:var(--c-panel2);border:1px solid var(--c-border);border-radius:10px;padding:14px;text-align:center;}
.icu-cell .city{font-size:11px;color:var(--c-muted);margin-bottom:8px;}
.icu-ring-num{font-family:var(--font-mono);font-size:18px;font-weight:700;}

@media (max-width:1000px){
  .grid-2, .grid-3, .type-grid, .stat-row, .assess-grid, .live-widget-row, .doctor-card-grid, .kpi-row{grid-template-columns:1fr 1fr;}
  .assess-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>
<div class="app">

  <div class="topbar">
    <div class="brand">
      <svg viewBox="0 0 24 24" fill="none">
