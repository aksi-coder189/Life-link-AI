    <!-- SCREEN 6: DOCTOR DASHBOARD — 100% console -->
    <section class="screen" id="screen-doctor">
      <div class="console">
        <div class="eyebrow">Step 06 · Doctor dashboard</div>
        <h1 class="screen-title">The trauma team, already briefed</h1>
        <p class="screen-sub">The trauma team, briefed before the doors open.</p>

        <div class="panel">
          <div class="patient-card">
            <div class="avatar-block">
              <div class="avatar-circle">R</div>
              <b>Rahul</b>
              <div style="color:var(--c-muted);font-size:12px;margin-top:4px;">Age 34 · Male</div>
              <div class="level-badge critical" style="margin-top:12px;font-size:11px;padding:6px 14px;">Heart Attack · Critical</div>
            </div>
