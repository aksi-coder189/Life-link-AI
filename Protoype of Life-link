    </div>

    <nav class="nav" id="nav">
      <div class="navitem" data-screen="dashboard"><span class="n">01</span>Home</div>
      <div class="navitem" data-screen="emergency"><span class="n">02</span>Emergency</div>
      <div class="navitem" data-screen="assessment"><span class="n">03</span>Assessment</div>
