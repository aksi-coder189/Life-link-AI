# LifeLink AI — local environment config
# This file is gitignored. Copy .env.example when setting up a new environment.

# SQLite by default — zero setup. Swap for a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/lifelink
DATABASE_URL=sqlite:///./lifelink.db

# Leave blank to disable auth (all endpoints open — fine for local dev/demo).
# Set a value to require `Authorization: Bearer <API_KEY>` on state-changing
# endpoints (POST/PUT/DELETE). Read-only GETs stay open either way.
API_KEY=

# Port the server binds to when started via `python main.py` directly
# (not used when running `uvicorn main:app` with an explicit --port flag).
PORT=8000
